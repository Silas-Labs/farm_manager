# =========================
# Root-level ignores
# =========================
# MacOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependency directories
node_modules/
**/node_modules/

# Build directories
dist/
build/
**/dist/
**/build/

# Environment variables
.env
.env.local
.env.*.local.

# npm / yarn / pnpm lock files
# (usually you want to commit one lock file for the whole repo)
# Uncomment if monorepo locks shouldn't be tracked
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# =========================
# Frontend (/frontend)
# =========================
/frontend/node_modules/
/frontend/build/
/frontend/.env.local
/frontend/.env.*.local
/frontend/.cache/

# Editor directories
/frontend/.vscode/
/frontend/.idea/

# =========================
# Backend (/backend)
# =========================
/backend/node_modules/
/backend/dist/
/backend/.env
/backend/.env.local
/backend/.env.*.local

# Debug and coverage
/backend/coverage/
/backend/.nyc_output/
/backend/.eslintcache

# Editor directories
/backend/.vscode/
/backend/.idea/